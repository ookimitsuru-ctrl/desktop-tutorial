; Engine configuration file.
; 仕様: docs/spec/11_technical_architecture.md §11.3

config_version=5

[application]

config/name="RINGBOUND"
config/description="オリジナル3D対戦格闘ゲーム"
config/version="0.9.2"
run/main_scene="res://src/app/ui/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/quit_on_go_back=false
config/icon="res://assets/ui/icon.svg"
boot_splash/bg_color=Color(0.043, 0.059, 0.102, 1)
boot_splash/show_image=false

[audio]

driver/output_latency=15
general/default_playback_type.mobile=0

[autoload]

Log="*res://src/app/autoload/log.gd"
Settings="*res://src/app/autoload/settings.gd"
SaveData="*res://src/app/autoload/save_data.gd"
DataDB="*res://src/app/autoload/data_db.gd"
InputHub="*res://src/app/autoload/input_hub.gd"
AudioHub="*res://src/app/autoload/audio_hub.gd"
SceneRouter="*res://src/app/autoload/scene_router.gd"
Game="*res://src/app/autoload/game.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[gui]

theme/custom="res://assets/ui/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.043, 0.059, 0.102, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
