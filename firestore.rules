rules_version = '2';

// Write enforcement lives in the Cloud Functions (Admin SDK), not here.
// Re-deriving "is it currently today (JST) for this dateId" purely in rules
// would duplicate functions/src/lib/dateUtil.js's logic a second time, with
// real risk of the two drifting apart at midnight boundaries. Instead: deny
// all direct client writes to server-managed collections, so every write is
// forced through assignToday / postMessage / touchActive, which enforce
// membership and date correctness server-side.
service cloud.firestore {
  match /databases/{database}/documents {

    match /municipalities/{municipalityId} {
      allow read: if true;
      allow write: if false; // scripts/seed-municipalities.js (Admin SDK) only
    }

    match /dailyEpochs/{dateId} {
      allow read: if true;
      allow write: if false; // Cloud Functions (Admin SDK) only

      match /rooms/{municipalityId} {
        allow read: if true;
        allow write: if false;

        match /messages/{messageId} {
          allow read: if true;
          allow write: if false; // postMessage callable only
        }

        match /members/{uid} {
          allow read: if true;
          allow write: if false; // assignToday / touchActive callables only
        }
      }

      match /assignments/{uid} {
        allow read: if true;
        allow write: if false; // assignToday callable only
      }
    }

    // Narrower than the "read fully public" default for rooms: presence is
    // not room content, so it defaults to owner-only read.
    match /presence/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // touchActive callable only
    }
  }
}
